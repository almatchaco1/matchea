# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/matcha_pos
PORT=5000
# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
# Shop timezone: decides which day a sale belongs to
SHOP_TZ=Asia/Manila
# Only needed in development if the client runs on another origin
CLIENT_ORIGIN=http://localhost:3000
# First admin account created by `npm run seed`
ADMIN_NAME=Owner
ADMIN_PIN=1234

# --- Online payment (PayMongo). Leave blank to offer pay-at-pickup only ---
# Secret key: dashboard.paymongo.com → Developers → API keys (sk_test_... to test, sk_live_... for real money)
PAYMONGO_SECRET_KEY=
# Webhook secret (whsk_...): Developers → Webhooks, URL https://YOUR-SITE/api/public/paymongo/webhook, event checkout_session.payment.paid
PAYMONGO_WEBHOOK_SECRET=
# Methods shown on the PayMongo page (only ones activated on your account)
PAYMONGO_METHODS=gcash,paymaya,qrph
# Your public website address, used for PayMongo's return links (e.g. https://matchea.onrender.com)
PUBLIC_URL=

# Customer sign-in (optional)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# "Order ready" text messages (semaphore.co)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=
